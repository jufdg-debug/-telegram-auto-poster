# ============================================================
# Copie este arquivo para .env apenas se for testar LOCALMENTE
# NUNCA faça commit do arquivo .env
# No GitHub, use Secrets e Variables (veja o README)
# ============================================================

# Obrigatório – token do seu bot do Telegram
TELEGRAM_BOT_TOKEN=seu_token_aqui

# ID do chat/grupo (já preenchido com o valor que você passou)
TELEGRAM_CHAT_ID=-1003634142944

# true = só detecta e mostra o que faria (não envia nada)
# false = envia de verdade para o Telegram
DRY_RUN=true

# Quantidade máxima de vídeos novos enviados por execução
MAX_VIDEOS_PER_RUN=2

# Modelo da legenda. Use {title} para o título do vídeo
CAPTION_TEMPLATE=🔥 Novo vídeo\n\n{title}
